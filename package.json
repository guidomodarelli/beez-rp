{
  "name": "beez-rp",
  "version": "0.5.0",
  "description": "Dependency-free release process shared by the Beez projects: stable version rules, Vercel build gate, Keep a Changelog and terminal UI.",
  "license": "MIT",
  "author": "Guido Modarelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/beez-rp.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "bin": {
    "beez-rp": "./bin/beez-rp.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./versions": {
      "types": "./types/versions.d.ts",
      "default": "./src/versions.js"
    },
    "./build-gate": {
      "types": "./types/build-gate.d.ts",
      "default": "./src/build-gate.js"
    },
    "./changelog": {
      "types": "./types/changelog.d.ts",
      "default": "./src/changelog.js"
    },
    "./changelog-ai": {
      "types": "./types/changelog-ai.d.ts",
      "default": "./src/changelog-ai.js"
    },
    "./terminal-ui": {
      "types": "./types/terminal-ui.d.ts",
      "default": "./src/terminal-ui.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "default": "./src/testing.js"
    },
    "./guard-publish": {
      "types": "./types/guard-publish.d.ts",
      "default": "./src/guard-publish.js"
    },
    "./package-manager": {
      "types": "./types/package-manager.d.ts",
      "default": "./src/package-manager.js"
    },
    "./version-files": {
      "types": "./types/version-files.d.ts",
      "default": "./src/version-files.js"
    },
    "./create-version": {
      "types": "./types/create-version/index.d.ts",
      "default": "./src/create-version/index.js"
    },
    "./constants": {
      "types": "./types/constants/index.d.ts",
      "default": "./src/constants/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "types",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build:types": "tsc -p tsconfig.types.json",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "create-version": "node bin/beez-rp.js create-version",
    "cv": "node bin/beez-rp.js create-version",
    "prepack": "pnpm build:types",
    "prepublishOnly": "node bin/beez-rp.js guard-publish"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
